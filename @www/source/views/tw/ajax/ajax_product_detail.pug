.modal-scroll-wrap.scrollbar-macosx(data-scroll-content data-parallax-scroll-proxy)
  .modal-contain
    .modal-dialog
      .modal-content
      .libox-ajax-detail
        .cir-btn.black.hover-cir.ajax_close(data-hover="yellowSmall")
          .cross
        // data-color 會由點進來的產品項目 帶入色碼
        // data-text 可選擇這頁面的字是黑(預設)/白 data-text="white"
        .product_detail(data-color="#f2d479" data-text="")
          section.top-wrap
            .product_detail_swiper.waypoint
              .swiper-container
                .swiper-wrapper 
                  each val in topSwiper
                    .swiper-slide 
                      .content
                        .img 
                          img(src= val.img, alt="")
              .swiper-pagination
              .swiper-arrow-wrap
                a.prev-btn(href="javascript:;")
                  i.icon-arrAngleLeft
                a.next-btn(href="javascript:;")
                  i.icon-arrAngle
            .title.waypoint
              h2 甜筒條凳 客製品
              p 甜蜜蜜、清涼涼的幸福饗宴
          // 商品規格&介紹
          section.product_detail_info
            // 商品規格
            article.spec
              .common-title.waypoint 
                .en Spec. 
                .ch 商品規格
              .right
                // 商品logo & 廠牌名
                // logo 最大寬度限制 140px
                // 點擊開啟品牌燈箱
                .spec-brand.hover-cir.waypoint(data-hover="yellowBig"
                  data-ajax-route="./ajax_brand_overview.html" 
                  data-ajax-container=".libox-container" 
                  data-ajax-callback="_brand.overviewCallback"
                  data-ajax)
                  .logo 
                    img(src="../../../uploads/product/logo-w.png", alt="")
                  .text 
                    span BRAND 
                    h2 Strauss Lab
                // 規格項目可新增
                .spec-info.waypoint
                  span.tit MATERIAL :
                  // 可自行斷行
                  .p-wrap
                    p 山毛櫸、高密度泡棉、
                      |<br>背靠 / 坐墊可拆式布套
                .spec-info.waypoint
                  span.tit SIZE :
                  .p-wrap
                    p 雙人座&emsp;W160 X D87 X H 88 X 座高 43.5
                    p 三人座&emsp;W200 X D87 X H 88 X 座高 43.5
                    p 1.5 人座&emsp;W120 X D87 X H 88 X 座高 43.5
                    p 腳几&emsp;W80 X D60 X 座高 43.5

            // 商品介紹
            // 段落編輯器
            article.intro
              .common-title.waypoint
                .en Introduction
                .ch 商品介紹
              ._articleBlock
                // 一段
                article._articleU(article-flex='center' img-row='x1' button-color="transparent" button-textcolor="#000000" button-border="1px solid #00000050" 
                button-color-hover="transparent" button-textcolor-hover='#000' button-border-hover='1px solid #000000')
                  ._contentWrap
                    ._imgCover.waypoint
                      ._cover
                        ._photo(video-id='LqMxioRA7_g'
                            video-type='youtubeAPI'
                            video-player-type='onPage'
                            video-player-playtype='click')
                          img(src='../../../uploads/product/detail-img01-960X580.jpg' alt='')
                    ._wordWrap.waypoint
                      p._P
                        |輕量、簡樸、體驗剛剛好的哲學。講究細節卻不鋪陳繁文縟節：實木溫潤
                        |<br>低調的特質，穩穩地撐持住漂浮感的坐背墊。
                        |<br>無扶手、無邊框；遊走床與沙發之間。
                        |<br>行、住、坐、臥，安如當下。坐觀雲起、雲湧、雲居停，一派從容。
                // 一段
                article._articleU(img-row='x3' button-color='#000' button-color-hover='#ccc')
                  ._contentWrap
                    ._imgCover.waypoint
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size01-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size02-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size03-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size04-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size05-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size06-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size07-310X200.jpg' alt='圖片描述')
                      ._cover
                        ._photo
                          img(src='../../../uploads/product/detail-size08-310X200.jpg' alt='圖片描述')
                    ._wordWrap.waypoint
                        h5._subH 尺寸樣式
                        p._P
                          | 雲起時包含雙人、三人、以及兩種臥榻尺寸，另外還有腳几、扶手、抱枕配件，
                          | <br>商品間可自由搭配，滿足您的個人需求
                          | <br>
                          | <br>
                          | 測量尺寸：公分 (cm)
          // 商品照片牆
          section.product_detail_photo
            .marquee
              .track 
                p PRODUCT GALLERY PRODUCT GALLERY PRODUCT GALLERY PRODUCT GALLERY PRODUCT GALLERY PRODUCT GALLERY PRODUCT GALLERY PRODUCT GALLERY
            // 樣式 輪播圖
            // 圖片建議尺寸 
            // 電腦版 : 1920X900
            // 手機版 : 380X490
            .type-swiper.waypoint
              .swiper-container
                .swiper-wrapper
                  each val in photoSwiper
                    .swiper-slide
                      .parallax-container(data-parallax-container)
                        .img-bg.desktop(style=`background-image: url(${val.img})` data-parallax data-parallax-bg data-parallax-proxy=".modal-scroll-wrap[data-parallax-scroll-proxy]")
                        .img-bg.mobile(style=`background-image: url(${val.img2})` data-parallax data-parallax-bg data-parallax-proxy=".modal-scroll-wrap[data-parallax-scroll-proxy]")
                .swiper-pagination.light
            // 樣式 兩張圖 : 選左靠上(data-type="left-top") 或右靠上(data-type="right-top")
            // 圖片建議尺寸: 540X732
            .type-row2(data-type="left-top")
              .block.waypoint
                .parallax-container(data-parallax-container)
                  .img-bg.b-lazy(data-src="../../../uploads/product/detail-img05-540X732.jpg" data-parallax data-parallax-bg)
                .text 
                  p 椅腳細節
              .block.waypoint
                .parallax-container(data-parallax-container)
                  .img-bg.b-lazy(data-src="../../../uploads/product/detail-img06-540X732.jpg" data-parallax data-parallax-bg)
                .text
                  p 背後細節
            // 樣式 一張大圖 : 選直式橫式
            // 選擇 靠左(data-type="left")/中(data-type="center")/右(data-type="right")
            // 圖片建議尺寸
            .type-row1(data-type="center")
              .block.horizon.waypoint
                .parallax-container(data-parallax-container)
                  .img-bg.b-lazy(data-src="../../../uploads/product/detail-img03-1200X900.jpg" data-parallax data-parallax-bg)
                .text
                  p 家中情境
                // 3組字 / 可以不一樣
                // 9種位置可選擇
                // (data-type="left-top" data-type="left-center" data-type="left-bottom")
                // (data-type="center-top" data-type="center-center" data-type="center-bottom")
                // (data-type="right-top" data-type="right-center" data-type="right-bottom")
                // data-move="top" 為固定的設定
                .title-type.title-move.small.type-over(data-type="right-bottom" data-move="top")
                  .en
                    span CHILL CHILL
                  .en
                    span CHILL LIFE LIFE
                  .en.border-bottom
                    span CHILL STYLE
            .type-row1(data-type="right")
              .block.straight.waypoint
                .parallax-container(data-parallax-container)
                  .img-bg.b-lazy(data-src="../../../uploads/product/detail-img04-785X1080.jpg" data-parallax data-parallax-bg)
                .text
                  p 與寵物共享
                .title-type.title-move.small.type-over(data-type="left-bottom" data-move="top")
                  .en
                    span SHARE LOVE
                  .en
                    span SHARE LOVE MORE
                  .en.border-bottom
                    span SHARE LOVE
            .type-row2(data-type="right-top")
              .block.waypoint
                .parallax-container(data-parallax-container)
                  .img-bg.b-lazy(data-src="../../../uploads/product/detail-img07-540X732.jpg" data-parallax data-parallax-bg)
                .text 
                  p 椅腳細節
              .block.waypoint
                .parallax-container(data-parallax-container)
                  .img-bg.b-lazy(data-src="../../../uploads/product/detail-img08-540X732.jpg" data-parallax data-parallax-bg)
                .text
                  p 背後細節
          // 圖寬限制 960px / 高度不限
          section.product_detail_fare.waypoint 
            .img 
              img(src="../../../uploads/shopping/fare-Lab-A5-01.jpg", alt="")
