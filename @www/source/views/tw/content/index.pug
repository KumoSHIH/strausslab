          // 兩圖樣式: type-row2 
          // 選擇 滿版 type-fullVer / 不滿版 type-disVer
          // 要選擇圖片比例: data-type="3X6" data-type="6X3" data-type="4X5" data-type="5X4" data-type="5X5" 
          // 圖片建議尺寸 : (data-type="4X5" data-type="5X4" data-type="5X5") 960X1030
          // 圖片建議尺寸 : (data-type="3X6" data-type="6X3") 大圖 1040X795 小圖 320X552
          // 家具 png 建議尺寸("4X5") : 640X790 & 960X1080
          // 靜態標題注意 : 英文/中文 可隨意是否要上(最後一個 span 要加上 border-bottom)
          section.type-row2.type-fullVer(data-type="4X5" data-shift-container)
            .title-type(data-type="left-bottom")
              span.en.white-after.white-after-index Discover Meet
              span.ch.border-bottom.white-after.white-after-index 重新定義生活風格‧挖掘全新體驗感知
            // 以下是 type-row2/type-row3/type-row4 的共同規則 (背景圖/背景色/是否有內容物件/內容物件的相關設定)
            .block-wrap
              a.block.hover-cir.white-after.white-after-index.cursor-none(href="javascript:;" data-hover="yellowBig")
                // 可上兩張圖: (hover換圖) / 也可只上一張
                // img-normal : 第一張圖
                .img-normal
                  .parallax-container(data-parallax-container)
                    // img-bg : 可選擇上圖(data-src="") 或是填入背景色(style="background-color: ")
                    .img-bg.b-lazy(data-src="" style="background-color: #f7c3b8" data-parallax data-parallax-bg)
                      // <div class="obj"> : 有家具物件(png) (不上可移除此結構)
                      // data-path : 根據家具物件的圖片處理方式 需選擇物件的位置 靠上(top)/下(bottom)/左(left)/右(right)
                      .obj(data-path="right")
                        img.b-lazy(src="../../../assets/img/blazy.gif" data-src="../../../uploads/index/sofa-640X790.png", alt="")
                  // 產品名稱可上可不上
                  .text 
                    p
                // img-cover : 第二張圖
                // 不上第二張圖可移除此結構
                .img-cover
                  .parallax-container(data-parallax-container)
                    // img-bg : 可選擇上圖(data-src="") 或是填入背景色(style="background-color:")
                    .img-bg.b-lazy(data-src="../../../uploads/index/color-block-960X1300.jpg" data-parallax data-parallax-bg)
                      .obj(data-path="right")
                        img.b-lazy(src="../../../assets/img/blazy.gif" data-src="../../../uploads/index/desk-960X1080.png", alt="")
                  // 產品名稱可上可不上
                  .text
                    p
              a.block.hover-cir.hover-text.white-after.white-after-index.cursor-none(href="javascript:;" data-hover="yellowBig")
                // 只有上一張圖的
                .img-normal
                  .parallax-container(data-parallax-container)
                    .img-bg.b-lazy(data-src="../../../uploads/index/color-block-960X1300.jpg" data-parallax data-parallax-bg)
                      .obj(data-path="right")
                        img.b-lazy(src="../../../assets/img/blazy.gif" data-src="../../../uploads/index/desk-960X1080.png", alt="")
                  .text
                    p
          // 三圖樣式: type-row3
          // 注意 : type-row3 和 type-row4 不要用b-lazy
