<!DOCTYPE html>
html(lang="zh-Hant-TW")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../../assets/css/member_step.css")
  body.member_step(data-page="member_change_password")
    include ../layouts/_ad.pug
    .mouse-container.libox-type
      #mouse 
        .circle
        .mark
          img(src="../../../assets/img/cursor.png", alt="")  
    .main-wrapper
      .all-wrapper
        main
          // 關閉按鈕
          // 跳出燈箱
          a.cir-btn.gray.hover-cir.close(href="javascript:;" data-hover="blue")
            .cross
          // 大標
          .step-title
            .title
              .left(data-aost data-aost-class="show")
                // 大標 & 敘述可改
                .unit-title
                  .left
                    span.en Change Password
                    span.ch 修改密碼
                    p 請於右方輸入您欲修改的新密碼，並再次輸入會員密碼
                      |，後我們將會發送六位驗證碼至您的新手機，確保此
                      |申請為本續人操作。
                  .right 
                    .step-num 
                      span.num
                      span.text
          // 步驟 1
          .step-content.cir-l.active(data-step="1" data-text="New Setting 修改密碼")
            .wrap 
              .left.cir.cir-small
              .right.cir.cir-big2
                // 手機版 步驟
                .mob-show
                  .step-num 
                    span.num 1 
                    span.text New Setting 修改密碼
                .range
                  .form 
                    // 輸入新的密碼
                    .form-row.password
                      .form-grid.no-trans-white
                        label.form-group.no-trans-white
                          p.subject
                            span NEW PASSWORD
                            span.bold 新的密碼
                          input(type="password" placeholder="請輸入至少八位數以上，並且包含英文與數字" autocomplete="off")
                    // 會員密碼
                    .form-row.password
                      .form-grid.no-trans-white
                        label.form-group.no-trans-white
                          p.subject
                            span PASSWORD
                            span.bold 會員密碼
                          input(type="password" placeholder="請輸入您當前使用的會員密碼" autocomplete="off")
                // 開始驗證
                .range
                  .form-row.button-wrap
                    .form-btn.form-done.hover-cir.bd0-dark(data-hover="yellowBig" onclick="_member_step.step('next')")
                      p.bold VERIFICATION 開始驗證
                      span.icon-arrAngle
          // 步驟 2
          .step-content.cir-m(data-step="2" data-text="Verification 驗證身分")
            .wrap
              .left.cir.cir-small
              .right.cir.cir-middle
                // 手機版 步驟
                .mob-show
                  .step-num 
                    span.num 2
                    span.text Verification 驗證身分
                .range
                  p.fz-14 我們已將驗證碼發送至 
                    span +886 123 456 789
                    |，請於時間內至下方輸入驗證碼，若遲遲未收到，可使用重新發送按鈕，或與我們聯繫。
                  // 驗證碼輸入
                  .form-code 
                    input(type="text" placeholder="000000" inputmode="numeric" maxlength="6")
                  // 倒數計時
                  // 重新計時JS: _member_step.init_count();
                  .countdown-wrap
                    p COUNTDOWN TIME 剩餘輸入時間
                    .countdown(data-type="count" data-seconds="300")
                  // 重新發送驗證碼
                  // 倒數完會加上 active
                  .resend(data-hover="blue")
                    div
                      p RESEND 重新發送驗證碼
                      .countdown(data-type="resend" data-seconds="120")
                      .btn-resend
                        span.icon-refresh
              .button-wrap
                .form-btn.d-none
                .form-btn.form-done.hover-cir.bd0-dark(data-hover="yellowBig" onclick="_member_step.step('next')")
                  p.bold SEND 完成驗證
                  span.icon-arrAngle
          // 步驟 3
          .step-content.cir-s(data-step="3")
            .cir-wrap
              .title
                // 大標 & 敘述可改
                .unit-title
                  .left
                    .title-type.title-move(data-type="center-top" data-move="top")
                      .en
                        span Success
                      .en
                        span Success
                      .en
                        span Success
                    span.ch 完成密碼修改
                    p 您的密碼已成功完成更新，為了確保帳號安全，請重新登入會員。
                  .right 
                    // 按鈕
                    .btn-wrap.big
                      a.btn-cir.hover-cir(href="./member.html" data-hover="blue")
                        .icon-send
                        span 會員登入
              .wrap
                .left.cir.cir-small
                .right.cir.cir-middle2

          // go top 
          .cir-btn.black.goTop.hover-cir(data-hover="blue")(data-anchor)
            .icon
              .icon-trangle-up
        // 操作尚未結束燈箱
        // _common.openliboxInner('unfinish');
        .libox-inner(data-name="unfinish")
          .libox-common
            .cir-wrap.login
              .cir-bg 
                .bg-text OOPS
                h5 Notice!
                h6 您的操作尚未結束
                p 若您離開此畫面，所有的操作將不會被紀錄，
                  |<br>請問確定要離開嗎？
                .wrap
                  .btn-close.ajax_close.hover-cir(data-hover="yellowSmall")
                    p BACK 取消返回
                  .btn-close.hover-cir(data-hover="yellowSmall")
                    p LEAVE 確定離開
  //引入的script
  include ../layouts/_script.pug