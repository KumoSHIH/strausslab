                    span.ch 宅配中 |
                      a.hover-cir(href="javascript:;" data-hover="yellowSmall") 貨號 1574589632
                // 金額 & 訂單詳情
                .detail
                  .price
                    span PRICE 訂單金額
                    span $ 20,800
                  .button-wrap
                    // 開啟客服對話
                    a.form-btn.form-done.hover-cir.bd0-red(href="javascript:;" data-hover="yellowBig" onclick="_common.openliboxInner('service')")
                      p NOTICE 有新回覆
                    a.form-btn.form-done.hover-cir.bd0.green(href="./member_detail.html" data-hover="yellowBig")
                      p DETAIL 查看詳情
                      span.icon-arrAngle
              // 已完成(運送狀態改變)
              // 七天以內的訂單 顯示 退換貨申請按鈕  
              // 超過七天的訂單 會顯示 已/未填寫評價按鈕
              // 注意按鈕class會有所不同
              li
                .thead 
