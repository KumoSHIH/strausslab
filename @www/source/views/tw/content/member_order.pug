        // 會員登出燈箱
        // 開啟: _common.openliboxInner('logout');
        .libox-inner(data-name="logout")
          .libox-common
            .cir-wrap.member
              .bg
              .cir-bg
                h5.white Log out
                h6.white 您已成功登出
                p 歡迎隨時回來！
                .wrap
                  .btn-close.ajax_close.hover-cir(data-hover="yellowSmall")
                    p OK 確認

        // 取消訂單
        // 開啟: _common.openliboxInner('cancle');
        .libox-inner(data-name="cancle")
          .libox-common
            .cir-wrap.login
              .cir-bg 
                .bg-text OOPS
                h5 Notice!
                h6 取消訂單
                p 訂單即將取消，請問您確定要取消訂單嗎？
                .wrap
                  .btn-close.hover-cir(data-hover="yellowSmall")
                    p OK 確認
                  .btn-close.ajax_close.hover-cir(data-hover="yellowSmall")
                    p BACK 返回

        // 新增
        // 訂單客服紀錄
        .libox-inner(data-name="service")
          .libox-common
            .content
              .cir-btn.mainGreen.ajax_close.hover-cir(data-hover="blue")
                .cross
              .top-title
                .tit
                  span.en Hello! 
                  span.ch.bold 訂單客服紀錄
                .text
                  span.ch NO. 訂單編號
                  span.en JDI2020110225
              // 訊息輸入框
              .text-box
                .tit WRITE MESSAGE 您的訊息
                .write-wrap
                  .textarea
                    textarea(placeholder="請填寫您的想法或建議於此...")
                  .btn-send.hover-cir(data-hover="blue")
                    span SEND
              // 對話紀錄
              .text-box
                .tit MESSAGE RECORD 對話紀錄
                .text-wrap
                  .scrollbar-inner(data-scrollbody)
                    .text-h
                      // 顧客訊息 box-right
                      .box.box-right
                        .message
                          .message-wrap
                            // 可斷行
                            p 您好，請問我的商品預計什麼時候出貨呢？是否可於過年前到貨～？
                          // 留言時間
                          p.date 2020/12/28 08:00
                        // 會員照片
                        .img
                          .headshot(style="background-image: url(../../../uploads/member/person-320X320.jpg)")
                          img(src="../../../uploads/member/person-320X320.jpg", alt="")
                        
                      // 客服訊息 box-left
                      .box.box-left
                        .message
                          .message-wrap
                            p Strauss Lab :<br>
                              | 親愛的會員您好，由於我們的商品是接單訂製，整體而言算是半客製化的品項，製作時間大概需要 7-20 個工作天不等。<br>一旦出貨我們會立刻發送通知給您，希望能夠將最好的體驗帶到你們的家中，敬請耐心等候，非常感謝！
                          p.date 2020/12/28 08:15
                        // 客服照片
                        .img 
                          .headshot(style="background-image: url(../../../uploads/member/person-320X320.jpg)")
                        
                      // 顧客訊息 box-right
                      .box.box-right
                        .message
                          .message-wrap
