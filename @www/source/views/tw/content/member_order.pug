                    a.form-btn.form-done.hover-cir.bd0-red(href="./member_evaluation_detail.html" data-hover="yellowBig")
                      p EVALUATION 填寫評價
                    a.form-btn.form-done.hover-cir.bd0.green(href="./member_detail.html" data-hover="yellowBig")
                      p DETAIL 查看詳情
                      span.icon-arrAngle
              li
                .thead 
                  .date
                    span.tit DATE 訂單成立日期
                    span.en 2020-12-25
                  .num
                    span.tit NO. 訂單編號
                    span.en JDI2020110225
                  .status
                    span.tit STATUS 訂單狀態
                    span.ch 已出貨
