<!DOCTYPE html>
html(lang="zh-Hant-TW")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../../assets/css/member_order.css")
  body.member_order(data-page="member_order")
    include ../layouts/_ad.pug
    .mouse-container.libox-type
      #mouse 
        .circle
        .mark
          img(src="../../../assets/img/cursor.png", alt="")  
    .main-wrapper
      .all-wrapper
        // 導覽列
        include ../layouts/_navbar.pug
        main
          // 背景圖可略過
          .bg(style="background-image:url(../../../uploads/member/bg-order.jpg)")
          // 大標
          section.member-title.type-detail
            .title.range
              .left-block(data-aost data-aost-class="show")
                // 大標 & 敘述可改
                .unit-title 
                  .left
                    span.ch 會員中心
                    span.en WELCOME!
                    p 歡迎來到會員中心，您可在此查看訂單，商品收藏，或是修改個人基本資料！
                // 會員登出
                // --
                .logout.hover-cir(data-hover="blue" onclick="_common.openliboxInner('logout')")
                  a.cir-btn.mainGreen(href="javascript:;")
                    .icon-cirArrow-2
                  span LOG OUT 會員登出
              // 會員相關連結
              .right(data-aost data-aost-class="show")
                each val,index in link
                  .link-text.hover-cir(data-hover="blueBig")
                    a(href=val.link)(class= index == 2 ? 'active': '')
                      .en
                        span= val.en
                        span= val.ch
                      .ch= val.ch

          // 訂單狀態切換
          section.member-status.range
            // 退貨申請暫不開放需要隱藏(欄位保留)
            .scrollbar-inner
              ul 
                each val,index in status
                  li(class= index == 0? 'active': '')(data-color= val.color)
                    a.hover-cir(href="javascript:;" data-hover="blueBig")
                      // 訂單狀態
                      span= val.title
                      if(val.num !== '')
                        // 沒有筆數不顯示此結構
                        div= val.num
          
          // 訂單紀錄
          section.order-list.range
            ul 
              // 處理中
              li
                // 訂單資訊
                .thead 
                  .date
                    span.tit DATE 訂單成立日期
                    span.en 2020-12-25
                  .num
                    span.tit NO. 訂單編號
                    span.en JDI2020110225
                  .status
                    span.tit STATUS 訂單狀態
                    span.ch 處理中
                  .payment 
                    span.tit PAYMENT 付款狀態
                    span.ch 未付款
                  .shipping
                    span.tit SHIPPING 運送狀態
                    span.ch 未出貨
                // 金額 & 訂單詳情
                .detail
                  .price
                    span PRICE 訂單金額
                    span $ 20,800
                  .button-wrap
                    // 開啟客服對話
                    a.form-btn.form-done.hover-cir.bd0-red(href="javascript:;" data-hover="yellowBig" onclick="_common.openliboxInner('service')")
                      p NOTICE 有新回覆
                    // 開啟取消訂單燈箱
                    a.form-btn.form-done.hover-cir.bd0.opt(href="javascript:;" data-hover="yellowBig" onclick="_common.openliboxInner('cancle')")
                      p CANCEL 取消訂單
                    a.form-btn.form-done.hover-cir.bd0.green(href="./member_detail.html" data-hover="yellowBig")
                      p DETAIL 查看詳情
                      span.icon-arrAngle
              // 備貨中(訂單狀態 & 付款狀態改變 沒有取消訂單按鈕)
              li
                .thead 
                  .date
                    span.tit DATE 訂單成立日期
                    span.en 2020-12-25
                  .num
                    span.tit NO. 訂單編號
                    span.en JDI2020110225
                  .status
                    span.tit STATUS 訂單狀態
                    span.ch 備貨中
                  .payment 
                    span.tit PAYMENT 付款狀態
                    span.ch 已付款
                  .shipping
                    span.tit SHIPPING 運送狀態
                    span.ch 未出貨 | 預計出貨日 2021-01-30
                // 金額 & 訂單詳情
                .detail
                  .price
                    span PRICE 訂單金額
                    span $ 20,800
                  .button-wrap
                    // 開啟客服對話
                    a.form-btn.form-done.hover-cir.bd0-red(href="javascript:;" data-hover="yellowBig" onclick="_common.openliboxInner('service')")
