                    span.tit DATE 訂單成立日期
                    span.en 2020-12-25
                  .num
                    span.tit NO. 訂單編號
                    span.en JDI2020110225
                  .status
                    span.tit STATUS 訂單狀態
                    span.ch 已出貨
                  .payment 
                    span.tit PAYMENT 付款狀態
                    span.ch 已付款
                  .shipping
                    span.tit SHIPPING 運送狀態
                    span.ch 已送達
                // 金額 & 訂單詳情
