<!DOCTYPE html>
html(lang="zh-Hant-TW")
  // head標籤 & 網站設定
  head(itemscope='itemscope', itemtype='http://schema.org/WebSite')
    //共用設定
    include ../layouts/_head.pug
    //獨立CSS
    link(rel="stylesheet", href="../../../assets/css/member_step.css")
  body.member_step(data-page="member_register")
    include ../layouts/_ad.pug
    .mouse-container.libox-type
      #mouse 
        .circle
        .mark
          img(src="../../../assets/img/cursor.png", alt="")  
    .main-wrapper
      .all-wrapper
        main
          // 關閉按鈕
          // 跳出燈箱
          a.cir-btn.gray.hover-cir.close(href="javascript:;" data-hover="blue")
            .cross
          // 大標
          .step-title
            .title
              .left(data-aost data-aost-class="show")
                // 大標 & 敘述可改
                .unit-title
                  .left
                    span.en Registered
                    span.ch 註冊會員
                    p 請於填寫正確的個人資料以及手機號碼，我們將會發送
                      |六位數的驗證碼至您的手機，確認此操作由本人進行。
                      <br>
                      <br>
                      |其他資料也將影響您參與我們會員活動的相關資格，
                      |<br>請確實填寫，以免損及會員權益！
                  .right 
                    .step-num 
                      span.num 1
                      span.text Create 建立帳號
                      // Create 建立帳號
          // 步驟 1
          // 
          .step-content.cir-xl.active(data-step="1" data-text="Create 建立帳號")
            .wrap 
              .left.cir.cir-small
              .right.cir.cir-big
                // 手機版 步驟
                .mob-show
                  .step-num 
                    span.num 1
                    span.text Create 建立帳號
                .range
                  p.fz-14 會員帳號即為您的手機號碼，請於下方輸入。
                  .form 
                    // 輸入電話號碼
                    .form-row
                      .form-grid.no-trans-white
                        label.form-group.no-trans-white
                          p.subject
                            span TEL
                            span.bold 手機號碼
                            span.bold + 886
                          input(type="text" placeholder="912345678" inputmode="numeric" autocomplete="off")
                    // 輸入密碼
                    .form-row.password
                      .form-grid.no-trans-white
                        label.form-group.no-trans-white
                          p.subject
                            span PASSWORD
                            span.bold 密碼
                          input(type="password" placeholder="請輸入至少八位數以上，並且包含英文與數字")
                    // 姓名
                    .form-row.mt-15
                      .form-grid
                        label.form-group.no-trans-white
                          p.subject
                            span NAME
                            span.bold 姓名
                          input(type="text" placeholder="請填寫真實姓名")
                      .form-grid
                        label.form-group.no-trans-white
                          p.subject
                            span NICKNAME
                            span.bold 暱稱
                          input(type="text" placeholder="請填寫您的暱稱")
                    // 稱謂
                    .form-row
                      .form-grid
                        .form-select.type-normal.no-trans-white
                          .select-head
                            p.option 
                              span.bold SELECT 請選擇稱謂
                            span.arrow-icon
                          .select-content
                            ul.scrollbar-inner
                              li 先生
                              li 小姐
                    // email
                    .form-row
                      .form-grid
                        label.form-group.no-trans-white
                          p.subject
                            span.bold E-mail
                            span
                          input(type="email" placeholder="example@strausslab.com" autocomplete="off")
                    // 出生年月
                    .form-row.birth
                      .form-grid
                        .form-select.type-normal.no-trans-white
                          .select-head
                            p.option.fakeline
                              span.bold BIRTH 生日
                              span.bold YEAR 年
                            span.arrow-icon
                          .select-content
                            ul.scrollbar-inner
                              li 1999
                              li 2000
                              li 2001
                      .form-grid
                        .form-select.type-normal.no-trans-white
                          .select-head
                            p.option 
                              span.bold MONTH 月
                            span.arrow-icon
                          .select-content
                            ul.scrollbar-inner
                              li 1
                              li 2
                              li 3
                              li 4
                      .form-grid
                        .form-select.type-normal.no-trans-white
                          .select-head
                            p.option 
                              span.bold DATE 日
                            span.arrow-icon
                          .select-content
                            ul.scrollbar-inner
                              li 1
                              li 2
                              li 3
                              li 4
                    // 收件住址
                    .form-row.mt-15
                      .form-grid
                        .form-select.type-normal.no-trans-white
                          .select-head
                            p.option.fakeline
                              span.bold ADDRESS 收件地址
                              span.bold 選擇縣市
                            span.arrow-icon
                          .select-content
                            ul.scrollbar-inner
                              li 台北市
                              li 新北市
                      .form-grid
                        .form-select.type-normal.no-trans-white
                          .select-head
                            p.option 
                              span.bold 選擇鄉鎮
                            span.arrow-icon
                          .select-content
                            ul.scrollbar-inner
                              li 大同區
                    .form-row    
                      .form-grid
                        label.form-group.no-trans-white
                          input.px-0(type="text" placeholder="詳細地址內容")
                // 開始驗證
                .range
                  .form-row.button-wrap
                    .form-btn.form-done.hover-cir.bd0-dark(data-hover="yellowBig" onclick="_member_step.step('next')")
                      p.bold VERIFICATION 開始驗證
                      span.icon-arrAngle
          // 步驟 2
          .step-content.cir-m(data-step="2" data-text="Verification 驗證身分")
            .wrap
              .left.cir.cir-small
              .right.cir.cir-middle
                // 手機版 步驟
                .mob-show
                  .step-num 
                    span.num 2
                    span.text Verification 驗證身分
                .range
                  p.fz-14 我們已將驗證碼發送至 
                    span +886 123 456 789
                    |，請於時間內至下方輸入驗證碼，若遲遲未收到，可使用重新發送按鈕，或與我們聯繫。
                  // 驗證碼輸入
                  .form-code 
                    input(type="text" placeholder="000000" inputmode="numeric" maxlength="6")
                  // 倒數計時
                  // 重新計時JS: _member_step.init_count();
                  .countdown-wrap
                    p COUNTDOWN TIME 剩餘輸入時間
                    .countdown(data-type="count" data-seconds="300")
                  // 重新發送驗證碼
                  // 倒數完會加上 active
                  .resend(data-hover="blue")
                    div
                      p RESEND 重新發送驗證碼
                      .countdown(data-type="resend" data-seconds="120")
                      .btn-resend
                        span.icon-refresh
              .button-wrap
                .form-btn.form-done.hover-cir.bd0-white(data-hover="yellowBig" onclick="_member_step.step('prev')")
                  span.icon-arrAngleLeft
                  p.bold BACK 返回修改
                .form-btn.form-done.hover-cir.bd0-white(data-hover="yellowBig" onclick="_member_step.step('next')")
                  p.bold SEND 完成驗證
                  span.icon-arrAngle
          // 步驟 3
          .step-content.cir-s(data-step="3")
            .cir-wrap
              .title
                // 大標 & 敘述可改
                .unit-title
                  .left
                    .title-type.title-move(data-type="center-top" data-move="top")
                      .en
                        span Welcome
                      .en
                        span Welcome
                      .en
                        span Welcome
                    span.ch 完成註冊
                    p 您已成功成為我們的會員，敬請前往挑選產品，或到會員中心了解更多會員功能與資訊。
                  .right 
                    // 按鈕
                    .btn-wrap.big
                      a.btn-cir.hover-cir(href="./product.html" data-hover="blue")
                        .icon-cart
                        span 開始逛逛
                      a.btn-cir.hover-cir(href="./member.html" data-hover="blue")
                        .icon-send
                        span 查看會員
              .wrap
                .left.cir.cir-small
                .right.cir.cir-middle2

          // go top 
          .cir-btn.black.goTop.hover-cir(data-hover="blue")(data-anchor)
            .icon
              .icon-trangle-up

        // 操作尚未結束燈箱
        // _common.openliboxInner('unfinish');
        .libox-inner(data-name="unfinish")
          .libox-common
            .cir-wrap.login
              .cir-bg 
                .bg-text OOPS
                h5 Notice!
                h6 您的操作尚未結束
                p 若您離開此畫面，所有的操作將不會被紀錄，
                  |<br>請問確定要離開嗎？
                .wrap
                  .btn-close.ajax_close.hover-cir(data-hover="yellowSmall")
                    p BACK 取消返回
                  .btn-close.hover-cir(data-hover="yellowSmall")
                    p LEAVE 確定離開
  //引入的script
  include ../layouts/_script.pug