                  path(d="M30.9,9.7C29.9,4.3,24.2,1,19.1,3c-1.2,0.5-2.2,1.1-3.2,2.1C15.8,5,15.8,5,15.7,4.9c-2.2-2-4.7-2.7-7.6-2.3c-3.9,0.7-7,4.3-7.1,8.2c-0.1,2.6,0.8,4.6,2.6,6.4C7,20.6,10.4,24,13.7,27.4c0.7,0.7,1.4,1.4,2.2,2.2c0.1-0.1,0.1-0.1,0.2-0.2c0.7-0.7,1.2-1.2,1.9-1.9c3.5-3.4,6.8-6.8,10.2-10.2C30.4,15.2,31.4,12.7,30.9,9.7z")
