          // 大: 380X250，小: 190X250
          // AJAX: 
          // _product_list.backendCallback();
          section.product_list_result
            ul 
              each val in data
                // 標準品 li+class: normal
                li(data-aost data-aost-class="show" data-aost-offset="95")(class= (val.type == 'normal'? 'normal': ''))
                  // data-bgcolor: 家具hover的背景底色
                  a.hover-cir(href="./product_detail.html" data-hover="border" data-bgcolor= val.bgcolor)(class= val.size)
                    if val.type == 'normal'
                      // 標準品選色
                      .dot
                        .dot-wrap
                          // data-route: 該色產品內頁
                          // data-img: 該色家具圖
                          // data-name: 該色家具名稱
                          // data-price: 該色家具價格
                          // data-text: 該色家具優惠狀態
                          // data-bg: 該色家具hover的背景底色
                          // data-line: true/false 是否要+ line-through
                          each dot in val.style
                            .dot-block(data-route="./product_detail2.html" data-img= dot.img data-name= dot.name data-price= dot.price data-text= dot.text data-bg= dot.bgcolor data-line= dot.line)
                              // 該色縮圖
                              img(src= dot.colorImg, alt="")
                    .img
                      img.b-lazy(src="../../../assets/img/blazy.gif" data-src= val.img, alt="")
                      // 圓圓標籤: 可上可不上
                      // 內容可自訂
                      // 底色可自訂 
                      // 位置可選左/右 +class="left" / "right"
                      .tag(class= val.direction)(style=`background-color: ${val.color}`)
                        span= val.tag
                      
                      if val.cus == true && val.tag !== ''
                        // 優惠標籤 與 客製化標籤同時存在 (位置(左右)一樣)
                        .tag.cus(class= val.direction)
                          .bg
                          span MORE
                      else if val.cus == true && val.tag == ''
                        // 只有客製化標籤時的狀態
                        .tag.cus.cus-left 
                          .bg
                          span MORE
                    .text-detail 
                      h2= val.name 
                      .price
                        span NTD$
                        span= val.price
                      // 優惠價 data-line="true"
                      .txt(class= (val.line == 'true' ? 'line-through': '') data-line= val.line)
                        span PRICE&ensp;
                        span= val.text
          
          // 相關產品
          section.product_list_more
            // 標題
            article.market-title
              // 固定樣式
              // 3組一樣的字(可改字)
              .title-type.title-move.small(data-type="center-top" data-move="top")
                .en
                  span MORE FUN
                .en
                  span MORE FUN
                .en.border-bottom
                  span MORE FUN
            
            // 相關產品區塊
            article.more-content
              ul 
                each val,index in relate
                  li(data-aost data-aost-class="show")
                    a.hover-cir.cursor-none(href="javascript:;" data-hover="yellowBig")
                      .img(style= (index == 0 ? "background-color: #a0f37b": ""))
                        img(src= val.img, alt="")
                      .text 
                        p.en= val.en
                        p.ch= val.ch


        // 產品選單
        .libox-menu(data-name="promenu")
          .menu-box
            .cir-btn.mainGreen.close-menu.hover-cir(data-hover="yellowBig")
              .cross
            // 商品分類 & 活動
            .other-wrap
              .scrollbar-inner
                .wrap
                  .category-box
                    .mob-wrap
                      .sub-tit
                        span.en Category
                        span.ch 商品分類
                      .btn-arrow 
                        span.icon-arrowDown
                    ul 
                      each val in series
                        li 
                          a.hover-cir(href="./product_list.html" data-hover="yellowSmall")
                            .img 
                              img(src= val.img, alt="")
                            .text 
                              span.ch= val.ch
                              span.en= val.en
                  .explore-box
                    .sub-tit
                      span.en Special
                      span.ch 探索更多
                    .explore-wrap
                      .txt-wrap.hover-cir(data-hover="blue")
                        .small-tit 
                          span.en HOT SALES
                          span.ch 促銷特惠
                        .open
                          .cross-plus
                      ul
                        each val in hot
                          li 
                            a.hover-cir(href="./product_list.html" data-hover="yellowSmall")
                              span.en= val.en
                              span.ch= val.ch
                    .explore-wrap
                      .txt-wrap.hover-cir(data-hover="blue")
                        .small-tit 
                          span.en INSPIRATION
                          span.ch 促銷特惠
                        .open
                          .cross-plus
                      ul
                        each val in inspire
                          li 
                            a.hover-cir(href="./product_list.html" data-hover="yellowSmall")
                              span.en= val.en
                              span.ch= val.ch
                    .explore-wrap 
                      .txt-wrap.hover-cir(data-hover="blue")
                        .small-tit 
                          span.en SPACE
                          span.ch 探索空間
                        .open
                          .cross-plus
                      ul
                        each val in space
                          li 
                            a.hover-cir(href="./product_list.html" data-hover="yellowSmall")
                              span.en= val.en
                              span.ch= val.ch
        // 頁尾
        include ../layouts/_footer.pug
        // 隱私權政策
        include ../layouts/_privacy.pug
    
  //引入的script
  include ../layouts/_script.pug
    