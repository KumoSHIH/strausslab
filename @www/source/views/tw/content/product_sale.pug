            .parallax-container(data-parallax-container)
              .img-bg.desktop.b-lazy(data-src="../../../uploads/product/banner-1920X840.jpg" data-parallax data-parallax-bg)
              .img-bg.mobile.b-lazy(data-src="../../../uploads/product/banner-380X660.jpg" data-parallax data-parallax-bg)
