                                  span.arrow-icon
                                .select-content
                                  ul.scrollbar-inner
                                    li 先生
                                    li 小姐
                          .form-row
                            .form-grid
                              .form-select.type-normal.dark
                                .select-head
                                  p.option 
                                    span.line ADDRESS 收件地址
                                    span 選擇縣市
                                  span.arrow-icon
                                .select-content
                                  ul.scrollbar-inner
                                    li 台北市
                                    li 新北市
                            .form-grid
                              .form-select.type-normal.dark
                                .select-head
                                  p.option 
                                    span 選擇鄉鎮
                                  span.arrow-icon
                                .select-content
                                  ul.scrollbar-inner
                                    li 區域1
                                    li 區域2
                          // 一排
                          .form-row
                            .form-grid
                              label.form-group.dark
                                input.px-0(type="text" placeholder="詳細地址內容" inputmode="" autocomplete="off")
                  .pick-wrap
                    .btn-cir
                      span.icon-check
                    .desc.column
                      p 三聯式發票 
                      .form
                        .pick-dropdown.d-none
                          .form-row
                            .form-grid
                              label.form-group.dark
                                p.subject
                                  span NAME
                                  span 姓名
                                input(type="text" placeholder="請填寫於此" autocomplete="off")
                            .form-grid
                              .form-select.type-normal.dark
                                .select-head
                                  p.option 
                                    span SELECT
                                    span 請選擇稱謂
                                  span.arrow-icon
                                .select-content
                                  ul.scrollbar-inner
                                    li 先生
                                    li 小姐
                          .form-row
                            .form-grid
                              .form-select.type-normal.dark
                                .select-head
                                  p.option 
                                    span.line ADDRESS 收件地址
                                    span 選擇縣市
                                  span.arrow-icon
                                .select-content
                                  ul.scrollbar-inner
                                    li 台北市
                                    li 新北市
                            .form-grid
                              .form-select.type-normal.dark
                                .select-head
                                  p.option 
                                    span 選擇鄉鎮
                                  span.arrow-icon
                                .select-content
                                  ul.scrollbar-inner
                                    li 區域1
                                    li 區域2
                          // 一排
                          .form-row
                            .form-grid
                              label.form-group.dark
                                input.px-0(type="text" placeholder="詳細地址內容" inputmode="" autocomplete="off")
                          // 一排
                          .form-row.mt-25
                            .form-grid
                              label.form-group.dark
                                p.subject
                                  span COMPANY 
                                  span 公司名稱
                                input(type="text" placeholder="請填寫於此" inputmode="" autocomplete="off")
                          // 一排
                          .form-row
                            .form-grid
                              label.form-group.dark
                                p.subject
                                  span TAX ID
                                  span 公司統編
                                input(type="text" placeholder="1234 5678" inputmode="numeric" autocomplete="off")
              // 總金額
              .box-item.total
                .text-wrap
                  .text 
                    span NTD$ 
                    p 89,751
                  span TOTAL&ensp;本次付款金額
                .btn-wrap
                  // 確定付款
                  // _common.openliboxInner('loading');
                  a.btn-cir.hover-cir(href="javascript:;" data-hover="blue")
                    span.icon-money 
                    span 確定付款
                .cir-btn.black.goTop.hover-cir(data-hover="blue")(data-anchor-target="" data-anchor-container=".libox-inner[data-name='pay'] .modal-contain[data-scroll-content]" data-anchor)
