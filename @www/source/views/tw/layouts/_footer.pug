      ch: '商品專區',
      url: './product.html'},
    {
      en: 'Contact',
      ch: '聯絡我們',
      url: './contact.html'},
  ]

  var social = [
    {
      icon: 'icon-facebook',
      name: 'facebook'},
    {
      icon: 'icon-instagram',
      name: 'instagram'},
    {
