footer.footer.waypoint(data-aost data-aost-class="show" data-aost-offset="90")
  .go-top.light(data-anchor-target="" data-anchor-speed="1800" data-anchor-callback="_home.anchorCallback" data-anchor)
    div
      i.icon-trangle-up
  .footer-left
    ul.footer-item 
      each val in footerItem
        li 
          a.hover-cir(href= val.url data-hover="blueBig" aria-label= val.en)
            span.en= val.en
            span.ch= val.ch
    ul.footer-social
      each val in social
        li
          a.hover-cir(href="javascript:;" data-hover="blueBig" target="_blank" aria-label= val.name rel="noreferrer noopener")
            span(class= val.icon)
    .footer-contact
      .footer-mail
        span.icon-mail
        p service@twucm.com
      .copyright 
        p © 2020 Strauss lab all right reserved. Design by 
          a.hover-cir(href="https://www.wddgroup.com/" data-hover="blueBig") WDD.
          a.privacy.hover-cir(href="javascript:;" data-hover="blueBig" data-libox="privacy") PRIVACY POLIVY
  .footer-right
    a.logo.hover-cir(href="./index.html" data-hover="blueBig" aria-label="home") 
      img(src="../../../assets/img/logo-w.png", alt="")

  
  